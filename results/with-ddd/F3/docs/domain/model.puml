@startuml
' Domain model, updated for CR-2 (three-pieces variant).
' decisions D5 to D8 in decisions.md explain version-1 differences.
' decisions D11 to D13 explain CR-1 additions.
' decisions D14 to D17 explain CR-2 additions.
' Members marked ~ are package-private: only classes in tictactoe.domain call them.
title Tic-Tac-Toe — domain model (CR-2)

class TicTacToe <<aggregate root>> {
  +TicTacToe(playerX: Player, playerO: Player)
  +put(coordinate: Coordinate): boolean
  +state(): State
  +currentPlayer(): Player
  +colorAt(coordinate: Coordinate): Color
}
note right of TicTacToe
  put() returns false and changes nothing
  when the Square is occupied (I3).
  It is the only public operation that
  changes a game (I10).
end note

class ThreePiecesTicTacToe <<aggregate root>> {
  +ThreePiecesTicTacToe(playerX: Player, playerO: Player)
  +put(coordinate: Coordinate): boolean
  +move(from: Coordinate, to: Coordinate): boolean
  +state(): State
  +currentPlayer(): Player
  +colorAt(coordinate: Coordinate): Color
}
note right of ThreePiecesTicTacToe
  Extends TicTacToe with Move phase.\n
  put() tracks Pieces remaining per Player.\n
  move() is valid only in X_TO_MOVE / O_TO_MOVE.\n
  No Draw: game continues until Win (I15).
end note

class Board {
  +colorAt(coordinate: Coordinate): Color
  +isEmpty(coordinate: Coordinate): boolean
  +isFull(): boolean
  +hasWin(color: Color): boolean
  ~put(coordinate: Coordinate, piece: Piece)
  ~move(from: Coordinate, to: Coordinate)
}

class Square {
  +coordinate(): Coordinate
  +color(): Color
  +isEmpty(): boolean
  ~put(piece: Piece)
  ~remove(): Piece
}

class Round {
  +current(): Player
  ~next()
}

abstract class Player {
  +color(): Color
  +{abstract} chooseCoordinate(game: TicTacToe): Coordinate
}

class HumanPlayer {
  +color(): Color
  +chooseCoordinate(game: TicTacToe): Coordinate
}
note right of HumanPlayer : Returns null.\nThe console reads input for the Human.

class PcPlayer {
  +color(): Color
  +chooseCoordinate(game: TicTacToe): Coordinate
}
note right of PcPlayer : Deterministic PC strategy:\n1. Win  2. Block  3. Center\n4. Corner  5. First empty

class Piece {
  +color(): Color
}

class Coordinate <<value object>> {
  +row(): int
  +column(): int
  +{static} all(): List<Coordinate>
}
note bottom of Coordinate : all() returns the 9 Coordinates\nin reading order.

class Line <<value object>> {
  +coordinates(): List<Coordinate>
  +{static} row(n: int): Line
  +{static} column(n: int): Line
  +{static} diagonal(): Line
  +{static} inverseDiagonal(): Line
  +{static} all(): List<Line>
}

enum Color {
  X
  O
  EMPTY
}

enum State {
  X_TO_PUT
  O_TO_PUT
  X_TO_MOVE
  O_TO_MOVE
  X_WINS
  O_WINS
  DRAW
  +isOver(): boolean
  +isMoving(): boolean
}

TicTacToe *-- "1" Board
TicTacToe *-- "1" Round
TicTacToe o-- "2" Player
TicTacToe --> "1" State
ThreePiecesTicTacToe *-- "1" Board
ThreePiecesTicTacToe *-- "1" Round
ThreePiecesTicTacToe o-- "2" Player
ThreePiecesTicTacToe --> "1" State
Round --> "2" Player : alternates
Board *-- "9" Square
Square o-- "0..1" Piece
Square *-- "1" Coordinate
Board ..> Line : hasWin checks\nthe 8 Lines
Line o-- "3" Coordinate
Player --> "1" Color
Piece --> "1" Color
HumanPlayer --|> Player
PcPlayer --|> Player
@enduml
